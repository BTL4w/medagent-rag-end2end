# Copy to `.env` in repo root (never commit real secrets).

APP_VERSION=1.0.0
APP_LOCALE=vi-VN
LOG_LEVEL=INFO

APP_PORT=8000
MAX_MESSAGE_LENGTH=4000

# CORS: comma-separated origins. Empty => allow "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Rate limit (only paths under /api/)
RATE_LIMIT_API_PER_MINUTE=120

# LLM / embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=
ROUTER_MODEL=gpt-4o-mini
PLANNER_MODEL=gpt-5-mini
SYNTHESIZER_MODEL=gpt-5-mini

# Pinecone retrieval
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=default

HYBRID_BM25_WEIGHT=0.4
HYBRID_DENSE_WEIGHT=0.6
USE_RERANKER=false
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_MAX_LENGTH=1024

COMPLEX_QA_MAX_SUB=5

# LangGraph memory checkpointer (memory | postgres)
CHECKPOINTER_BACKEND=memory
MEMORY_URL=

# API persistence (optional Postgres — empty => in-memory store)
API_DATABASE_URL=

# Google Calendar (optional)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_CALENDAR_ID=
